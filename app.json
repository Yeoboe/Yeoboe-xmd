  "env": {
    "SESSION_ID": {
      "description": "Yeoboe-xmd  session token (Yeoboe-x~...) — get yours on the pairing site",
      "required": true,
      "value": ""
    }
  },
  "addons": [
    {
      "plan": "heroku-postgresql"
    }
  ]
}