{
  "name": "Yeoboe-xmd",
  "description": "Yeoboe-xmd - WhatsApp MD Multi-Device Bot powered by Baileys",
  "repository": "https://github.com/Yeoboe/Yeoboe-xmd",
  "logo": "",
  "keywords": [
    "whatsapp",
    "baileys",
    "bot",
    "node",
    "md",
    "Yeoboe-xmd"
  ],
  "stack": "heroku-26",
  "buildpacks": [
    {
      "url": "https://github.com/heroku/heroku-buildpack-nodejs.git"
    }
  ],
  "formation": {
    "web": {
      "quantity": 1,
      "size": "basic"
    }
